{
    "name": "alexandrebulete/ddd-foundation",
    "description": "Pure PHP DDD Foundation - Domain, Application, and InMemory infrastructure for building DDD projects",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandre Bulete"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/uid": "^7.0 || ^8.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "AlexandreBulete\\DddFoundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexandreBulete\\DddFoundation\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "qa": [
            "@phpstan",
            "@test"
        ]
    }
}
